+// Manual BorshSerialize/BorshDeserialize for packed structs to avoid
+// taking references to unaligned fields (E0793 in Rust 1.84+).
+impl BorshSerialize for InnerNode {
+    fn serialize<W: std::io::Write>(&self, writer: &mut W) -> std::io::Result<()> {
+        writer.write_all(bytes_of(self))
+    }
+}
+
+impl BorshDeserialize for InnerNode {
+    fn deserialize_reader<R: std::io::Read>(reader: &mut R) -> std::io::Result<Self> {
+        let mut buf = [0u8; size_of::<InnerNode>()];
+        reader.read_exact(&mut buf)?;
+        try_from_bytes::<InnerNode>(&buf)
+            .copied()
+            .map_err(|e| std::io::Error::new(std::io::ErrorKind::InvalidData, e.to_string()))
+    }
+}
+
+impl BorshSerialize for LeafNode {
+    fn serialize<W: std::io::Write>(&self, writer: &mut W) -> std::io::Result<()> {
+        writer.write_all(bytes_of(self))
+    }
+}
+
+impl BorshDeserialize for LeafNode {
+    fn deserialize_reader<R: std::io::Read>(reader: &mut R) -> std::io::Result<Self> {
+        let mut buf = [0u8; size_of::<LeafNode>()];
+        reader.read_exact(&mut buf)?;
+        try_from_bytes::<LeafNode>(&buf)
+            .copied()
+            .map_err(|e| std::io::Error::new(std::io::ErrorKind::InvalidData, e.to_string()))
+    }
+}
